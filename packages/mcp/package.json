{
  "name": "@flowdeck/mcp",
  "version": "0.2.1",
  "type": "module",
  "description": "FlowDeck MCP server — present AI coding plans as an editable modular canvas in the browser",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "flowdeck": "./bin/flowdeck.js"
  },
  "files": [
    "dist",
    "bin",
    "web-dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@flowdeck/core": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.6.0"
  }
}
